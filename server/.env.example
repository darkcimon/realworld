# AI 선생님을 실제 LLM으로 쓰려면 아래 중 하나를 채우고 파일명을 .env로 바꾸세요.
# 둘 다 비어 있으면(또는 이 파일 자체가 없으면) 서버는 자동으로 MockAIProvider(고정 문제은행/캔드 응답)로 동작합니다.

# 무료(요금 없음) — https://aistudio.google.com/apikey 에서 구글 계정으로 발급
GEMINI_API_KEY=

# 유료(토큰 종량 과금) — GEMINI_API_KEY가 없을 때만 대신 사용됨
ANTHROPIC_API_KEY=

# 배포 환경 설정
# JWT 서명 키 — 운영에서는 반드시 긴 임의 문자열로 지정 (비우면 개발용 기본값 사용)
JWT_SECRET=
# SQLite 파일 경로 — Railway에서는 볼륨 마운트 경로 아래로 지정 (예: /data/data.sqlite)
DB_PATH=

# 휴대폰 알림(웹 푸시) VAPID 키 — 비우면 처음 실행 때 만들어 DB에 저장한다.
# DB를 새로 만들면 키가 바뀌어 기존 구독이 모두 끊기므로, 운영에서는 한 번 만든 키를 여기에 고정해 두는 걸 권장.
# 만들기: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 푸시 서비스가 문제 있을 때 연락할 주소 (mailto: 또는 https:)
VAPID_SUBJECT=mailto:admin@example.com

# Play 스토어 앱(TWA) 도메인 인증 — /.well-known/assetlinks.json 으로 제공된다 (android/README.md 참고)
# 패키지 이름 (예: com.yourname.lifesim)
TWA_PACKAGE_NAME=
# 앱 서명 인증서 SHA-256 지문. 여러 개면 쉼표로 (Play 앱 서명 키 + 업로드 키)
TWA_SHA256_FINGERPRINTS=

# 광고(AdSense) 게시자 ID (예: pub-1234567890123456) — 넣으면 /ads.txt 가 생긴다. 내 도메인에서만 의미 있음
ADSENSE_PUBLISHER_ID=
